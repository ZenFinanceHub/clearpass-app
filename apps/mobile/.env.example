EXPO_PUBLIC_API_URL=https://clearpass-app.vercel.app
EXPO_PUBLIC_SENTRY_DSN=https://<key>@<host>.ingest.de.sentry.io/<project-id>

# RevenueCat — platform-specific public API keys (RC dashboard > Project
# settings > API keys). Safe to expose client-side, same as the Supabase
# anon key: these only identify the app/project to RC, they don't grant
# write access. Leave unset until each platform's store product exists —
# src/purchases.ts falls back to the coming-soon purchase route when a key
# is missing, it does not error.
EXPO_PUBLIC_REVENUECAT_API_KEY_IOS=
EXPO_PUBLIC_REVENUECAT_API_KEY_ANDROID=
